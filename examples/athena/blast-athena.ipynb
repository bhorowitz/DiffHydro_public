   "source": [
    "### Sedov-Taylor Blasts\n",
    "\n",
    "Welcome to DiffHydro! This is the first tutorial notebook and will also serve as a verification/exploration in basic shock physics."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "#Depending on your system/cluster, you may want to specify which GPU you want to use\n",
    "import os\n",
    "os.environ['CUDA_DEVICE_ORDER'] = 'PCI_BUS_ID'\n",
    "os.environ['CUDA_VISIBLE_DEVICES'] = '6' #on CPU you can leave it as '' \n",
    "\n",
    "\n",
    "import jax \n",
    "jax.config.update('jax_disable_jit', False) #turn this True for better debugging, much slower\n",
    "\n",
    "import jax.numpy as jnp #all of the numpy-like functionalities\n",
    "\n",
    "#core diffhydro\n",
    "import diffhydro as dh\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "#load athena ICs\n",
    "from diffhydro.utils.io import athinput,athdf\n",
    "\n",
    "athena_outputs_loc = \"../../data/athena_comparison/\"\n",
    "\n",
    "ic_filename = \"Blast.out2.00000.athdf\"\n",
    "\n",
    "\n",
    "ICs = athdf(athena_outputs_loc+ic_filename)\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [],
   "source": [
    "#setting up my dh ICs to match the athena file\n",
    "#will probably package this up into a single common func\n",
    "sol = jnp.zeros((5,100,100,100))\n",
    "sol = sol.at[0].set(ICs[\"dens\"])\n",
    "sol = sol.at[-1].set(ICs[\"Etot\"])"
   ]
  },
